{
  "name": "env",
  "version": "1.0.0",
  "description": "Visual canvas workspace for AI conversations",
  "main": "main.js",
  "private": true,
  "dependencies": {
    "@openai/codex-sdk": "^0.98.0",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "react-scripts": "5.0.1",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run react-build && electron-builder --mac",
    "build:dmg": "npm run react-build && electron-builder --mac dmg",
    "sync-servers": "node scripts/sync-mcp-servers.js"
  },
  "build": {
    "appId": "id.dotenv.env",
    "productName": "env",
    "publish": null,
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "mcp-client.js",
      "utils/**/*",
      "node_modules/electron-store/**/*",
      "!node_modules/react-scripts/**/*",
      "!node_modules/@babel/**/*",
      "!node_modules/webpack/**/*",
      "!node_modules/rollup/**/*",
      "!node_modules/tailwindcss/**/*",
      "!node_modules/@typescript-eslint/**/*",
      "!node_modules/eslint/**/*",
      "!node_modules/@jest/**/*",
      "!node_modules/workbox-build/**/*",
      "!node_modules/jsdom/**/*",
      "!node_modules/postcss-svgo/**/*",
      "!node_modules/csso/**/*",
      "!node_modules/axe-core/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "extends": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "env",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  },
  "homepage": "./"
}

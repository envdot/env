    {
      "name": "desktop",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=$HOME/.nvm/versions/node/v22.22.0/bin:$PATH && pnpm --filter @env/desktop dev"],
      "port": 3000
    },
    {
      "name": "landing",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=$HOME/.nvm/versions/node/v22.22.0/bin:$PATH && cd web && npx -y serve -l 4321 ."],

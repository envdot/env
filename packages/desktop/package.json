{
  "name": "@env/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "dependencies": {
    "@env/shared": "workspace:*",
    "@openai/codex-sdk": "^0.98.0",
    "electron-store": "^8.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "react-scripts": "5.0.1",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run react-build && electron-builder --mac",
    "build:dmg": "npm run react-build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "id.dotenv.env",
    "productName": "env",
    "publish": null,
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "mcp-client.js",
      "oauth-manager.js",
      "utils/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/sql.js/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "extends": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": ["dmg"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "env",
      "icon": "assets/icon.icns",
      "contents": [
        { "x": 150, "y": 200 },
        { "x": 450, "y": 200, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "browserslist": {
    "production": ["last 1 electron version"],
    "development": ["last 1 electron version"]
  },
  "homepage": "./"
}
